{
    "name": "prosektorbuilder",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "PROJECT_BACKEND=${PROJECT_BACKEND:-memory} next dev --webpack --port 3001",
        "build": "next build --webpack",
        "start": "next start --port 3001",
        "lint": "eslint",
        "clean:files": "bash ./scripts/clean_workspace.sh --apply",
        "clean:files:dry": "bash ./scripts/clean_workspace.sh",
        "hygiene:repo": "bash ./scripts/check_repo_hygiene.sh",
        "hygiene:git": "bash ./scripts/git_preflight.sh",
        "hooks:install": "git config core.hooksPath .githooks",
        "test": "tsx --test tests/*.test.ts",
        "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
        "test:strict": "npm run test:typecheck && npm run test",
        "ci:verify": "npm run hygiene:repo && npm run test:strict && npm run build",
        "typecheck": "tsc --noEmit",
        "db:migrate": "prisma migrate dev",
        "db:push": "prisma db push",
        "db:seed": "tsx prisma/seed.ts",
        "db:studio": "prisma studio"
    },
    "dependencies": {
        "@prisma/client": "^6.0.0",
        "@radix-ui/react-slot": "^1.2.4",
        "@react-pdf/renderer": "^4.3.2",
        "@supabase/supabase-js": "^2.94.0",
        "@tiptap/extension-image": "^3.18.0",
        "@tiptap/extension-link": "^3.17.0",
        "@tiptap/extension-table": "^3.18.0",
        "@tiptap/extension-table-cell": "^3.18.0",
        "@tiptap/extension-table-header": "^3.18.0",
        "@tiptap/extension-table-row": "^3.18.0",
        "@tiptap/react": "^3.17.0",
        "@tiptap/starter-kit": "^3.17.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "graphql": "^16.12.0",
        "lucide-react": "^0.562.0",
        "next": "^16.1.6",
        "next-auth": "^5.0.0-beta.30",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "sonner": "^1.7.1",
        "tailwind-merge": "^2.5.5",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.0.0",
        "@types/node": "^20.17.10",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "eslint": "^8.57.1",
        "eslint-config-next": "15.1.2",
        "prisma": "^6.0.0",
        "tailwindcss": "^4",
        "tsx": "^4.19.0",
        "typescript": "^5"
    }
}
