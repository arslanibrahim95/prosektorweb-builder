# Core runtime
NODE_ENV=production
DATABASE_URL=postgresql://postgres:password@db:5432/prosektorweb
PAYLOAD_SECRET=replace-with-random-secret
NEXTAUTH_SECRET=replace-with-random-secret

# Domain routing
NEXT_PUBLIC_ROOT_DOMAIN=prosektorweb.com
NEXT_PUBLIC_DASHBOARD_HOST=dashboard.prosektorweb.com
NEXT_PUBLIC_DEMO_HOST=demo.prosektorweb.com
DASHBOARD_HOST=dashboard.prosektorweb.com
DEMO_HOST=demo.prosektorweb.com
ACME_EMAIL=ops@prosektorweb.com

# Dashboard <-> Demo integration
DASHBOARD_PUBLIC_API_BASE=https://dashboard.prosektorweb.com
DASHBOARD_API_BASE=https://dashboard.prosektorweb.com
DASHBOARD_API_TOKEN=replace-with-dashboard-token
DASHBOARD_LOCAL_DIRECT_ADAPTER=true

DEMO_BASE_URL=https://demo.prosektorweb.com
NEXT_PUBLIC_DEMO_BASE_URL=https://demo.prosektorweb.com
DEMO_PUBLISH_WEBHOOK_URL=https://demo.prosektorweb.com/api/internal/publish
DEMO_PUBLISH_WEBHOOK_SECRET=replace-with-shared-webhook-secret

# AI provider
OPENAI_API_KEY=sk-...

# Optional replay store (recommended for multi-instance)
DEMO_REPLAY_REDIS_REST_URL=
DEMO_REPLAY_REDIS_REST_TOKEN=
DEMO_REPLAY_REDIS_KEY_PREFIX=demo:publish:replay

# Optional domain automation
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SERVER_IP=

# Optional publish quality gate
PUBLISH_MIN_QA_SCORE=70
PUBLISH_REQUIRE_QA_SCORE=false

# Optional deploy automation
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
CONTAINER_REGISTRY=ghcr.io
K8S_CLUSTER_URL=
K8S_TOKEN=
