generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// AUTHENTICATION MODELS
// ==========================================

enum UserRole {
  ADMIN
  USER
  PARTNER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])
  projects      WebProject[]
  auditLogs     AuditLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

// ==========================================
// CORE BUSINESS MODELS
// ==========================================

model Company {
  id          String       @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?      @db.Text
  taxId       String?
  logoUrl     String?
  users       User[]
  projects    WebProject[]
  media       SiteMedia[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum ProjectStatus {
  DRAFT
  PLANNING
  DESIGNING
  DEVELOPMENT
  REVIEW
  LIVE
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model WebProject {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?         @db.Text
  template    String?         @default("standard")
  industry    String?         @default("OSGB")
  status      ProjectStatus   @default(DRAFT)
  priority    ProjectPriority @default(MEDIUM)
  
  // Ownership
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  userId      String?
  user        User?           @relation(fields: [userId], references: [id])
  
  // Infrastructure
  domainId    String?         @unique
  domain      Domain?         @relation(fields: [domainId], references: [id])
  previewUrl  String?
  siteUrl     String?
  
  // Progress & Stats
  progress    Int             @default(0)
  version     Int             @default(1)
  
  // Contents
  generatedContents GeneratedContent[]
  pages             Page[]
  tasks             ProjectTask[]
  siteSettings      SiteSettings?
  blogPosts         BlogPost[]
  approvalRuns      AgentApprovalRun[]
  
  // Finances
  price       Float?
  isPaid      Boolean         @default(false)
  paidAt      DateTime?
  notes       String?         @db.Text
  
  // Timestamps
  startedAt   DateTime?
  completedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  serviceId   String?
  service     Service?        @relation(fields: [serviceId], references: [id])
}

model GeneratedContent {
  id              String     @id @default(cuid())
  projectId       String
  project         WebProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentType     String     // HOMEPAGE, ABOUT, SERVICES, FAQ, CONTACT
  title           String?
  content         String     @db.Text
  metaTitle       String?
  metaDescription String?    @db.Text
  status          String     @default("DRAFT") // DRAFT, REVIEW, APPROVED
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([projectId, contentType])
}

model Page {
  id        String     @id @default(cuid())
  projectId String
  project   WebProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  sections  Section[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([projectId, slug])
}

model Section {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String
  title     String?
  content   String?  @db.Text
  metadata  Json?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}

// ==========================================
// INFRASTRUCTURE MODELS
// ==========================================

model Domain {
  id          String       @id @default(cuid())
  name        String       @unique
  registrar   String?
  status      String       @default("PENDING") // PENDING, VERIFIED, ACTIVE
  serverIp    String?
  notes       String?      @db.Text
  project     WebProject?
  dnsRecords  DnsRecord[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model DnsRecord {
  id        String   @id @default(cuid())
  domainId  String
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  type      String   // A, CNAME, MX, TXT, etc.
  name      String   // @, www, etc.
  value     String   @db.Text
  ttl       Int      @default(3600)
  priority  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// SYSTEM MODELS
// ==========================================

model Service {
  id          String       @id @default(cuid())
  name        String
  description String?      @db.Text
  projects    WebProject[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ProjectTask {
  id        String     @id @default(cuid())
  projectId String
  project   WebProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  status    String     @default("TODO")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  DEPLOY
}

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  entity    String
  entityId  String
  details   String?     @db.Text
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  userEmail String?
  userName  String?
  createdAt DateTime    @default(now())
}

model ApiConfig {
  id        String   @id @default(cuid())
  provider  String   @unique // CLOUDFLARE, OPENAI
  apiKey    String
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// SITE CONTENT MODELS
// ==========================================

model SiteSettings {
  id              String     @id @default(cuid())
  projectId       String     @unique
  project         WebProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // İletişim
  phone           String?
  email           String?
  address         String?    @db.Text
  workingHours    String?
  mapEmbed        String?    @db.Text

  // Sosyal Medya
  socialMedia     Json?      // { facebook, twitter, instagram, linkedin, youtube }

  // SEO
  siteTitle       String?
  siteDescription String?    @db.Text
  keywords        String[]

  // Tasarım
  design          Json?      // { primaryColor, secondaryColor, fontHeading, fontBody, logoUrl, faviconUrl }

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model SiteMedia {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  filename  String
  url       String
  category  String   @default("GENERAL") // GENERAL, LOGO, HERO, GALLERY, TEAM, etc.
  alt       String?
  size      Int?
  mimeType  String?
  createdAt DateTime @default(now())
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id          String         @id @default(cuid())
  projectId   String
  project     WebProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  excerpt     String?        @db.Text
  content     String         @db.Text
  coverImage  String?
  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([projectId, slug])
  @@index([projectId, status])
}

// ==========================================
// AGENT APPROVAL MODELS
// ==========================================

enum AgentApprovalStep {
  GENERATE
  PUBLISH
}

enum AgentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  OVERRIDDEN
}

enum AgentVoteDecision {
  APPROVE
  REJECT
}

model AgentApprovalRun {
  id                 String              @id @default(cuid())
  projectId          String
  project            WebProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  step               AgentApprovalStep
  contentFingerprint String
  status             AgentApprovalStatus @default(PENDING)
  requiredVotes      Int                 @default(3)
  receivedVotes      Int                 @default(0)
  approvedVotes      Int                 @default(0)
  threshold          Int                 @default(80)
  timeoutMs          Int                 @default(20000)
  reason             String?             @db.Text
  forced             Boolean             @default(false)
  forcedByUserId     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  votes              AgentApprovalVote[]

  @@index([projectId, step, createdAt])
  @@unique([projectId, step, contentFingerprint])
}

model AgentApprovalVote {
  id          String           @id @default(cuid())
  runId       String
  run         AgentApprovalRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  reviewerKey String
  decision    AgentVoteDecision
  score       Int
  rationale   String           @db.Text
  latencyMs   Int?
  raw         Json?
  timedOut    Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([runId, reviewerKey])
  @@unique([runId, reviewerKey])
}
