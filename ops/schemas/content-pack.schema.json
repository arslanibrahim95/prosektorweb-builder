{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osgb.local/schemas/content-pack.schema.json",
  "title": "ContentPack",
  "type": "object",
  "required": ["pages", "imagePrompts", "toneGuide"],
  "properties": {
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "title", "sections", "seo"],
        "properties": {
          "slug": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "sections": {
            "type": "array",
            "items": { "type": "object" }
          },
          "seo": {
            "type": "object",
            "required": ["title", "description"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "imagePrompts": {
      "type": "array",
      "minItems": 1
    },
    "toneGuide": {}
  }
}
