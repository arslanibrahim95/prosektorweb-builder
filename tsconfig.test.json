{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "incremental": false,
    "skipLibCheck": true
  },
  "include": [
    "tests/**/*.test.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
